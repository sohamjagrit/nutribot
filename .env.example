# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=nutrition-index

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
# Fast model for router, grader, rewriter
FAST_MODEL=claude-haiku-4-5-20251001
MAX_RETRIEVAL_RETRIES=1

# Embeddings (any SentenceTransformer model name)
EMBED_MODEL=BAAI/bge-base-en-v1.5

# Retrieval
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=15
RERANK_TOP_K=5
MIN_RELEVANCE_SCORE=-4.0

# Context management (summarize older messages once history exceeds the budget)
CONTEXT_TOKEN_BUDGET=6000
KEEP_LAST_MESSAGES=6

# Conversation memory (SQLite — path relative to project root)
SQLITE_DB_PATH=data/memory.db

# OpenNutrition MCP server (compose service name; host-run default is http://localhost:3000/mcp)
MCP_NUTRITION_URL=http://opennutrition:3000/mcp

# LangSmith (optional, for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=nutribot
